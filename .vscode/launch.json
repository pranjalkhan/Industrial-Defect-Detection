{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "FastAPI Server (uvicorn)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--host", "127.0.0.1", "--port", "8000"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "Streamlit Dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app/dashboard.py", "--server.port", "8501"],
      "cwd": "${workspaceFolder}",
      "env": {
        "USERPROFILE": "${workspaceFolder}"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "Run Pipeline (--evaluate)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_pipeline.py",
      "args": ["--evaluate", "--compare"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
